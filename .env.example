# Copy this file to `.env` (same folder as nightjar.py) and fill in your key.
#
#     copy .env.example .env          Windows
#     cp   .env.example .env          macOS / Linux
#
# `.env` is gitignored. Nothing here ever belongs in config.json - that file
# gets pasted into bug reports, and this repo is public.
#
# Only needed if you turn on compose.hosted_fallback in config.json. With it
# off, Nightjar is fully local and this file is ignored.
#
# Nightjar also reads the real environment first, and a `.env` in the OS config
# dir second (%APPDATA%\nightjar on Windows, ~/.config/nightjar on Linux,
# ~/Library/Application Support/nightjar on macOS) - use that one if you want a
# machine-wide key that survives re-cloning the repo.

OPENAI_API_KEY=

# Set this ONLY if you expose the engine beyond 127.0.0.1 - an ngrok tunnel, a
# reverse proxy, a cloud host. When it is set, `python -m memory.server` refuses
# every request that does not carry it, and the client sends it as
# `ui.server_key` in config.json. Leave it empty for a local-only setup: on
# loopback the operating system is already the authentication.
#
# Do not rely on the tunnel to do this instead. ngrok 3.23.3 accepts
# `--basic-auth` and enforces nothing, with no error and no warning.
NIGHTJAR_SERVER_KEY=
